{% comment %}
  Wiskr Quiz — App Block.
  Renders the merchant's published quiz inline via iframe.
  Configure the Quiz ID in the theme editor (the App URL is prefilled).
{% endcomment %}

{%- assign clean_url = block.settings.app_url | strip | replace: ' ', '' -%}
{%- assign quiz_id = block.settings.quiz_id | strip -%}

<div class="quizocalypse-block" {{ block.shopify_attributes }}>
  {%- if quiz_id != blank and clean_url != blank -%}
    {%- if block.settings.render_mode == 'dom' -%}
      {%- comment -%}
        DOM mode: the quiz mounts directly into this document instead of a
        cross-origin iframe. The runtime becomes same-origin with the cart, so
        add-to-cart drops the postMessage bridge below, and the block's height
        is simply its content height (no qz:height listener, no min_height
        guess). localStorage stops being partitioned, so save/resume survives.

        The script is served from the app origin, not as a theme asset, so a
        runtime fix reaches every storefront on our next deploy with no theme
        edit and no extension release — the same update loop the iframe has.

        `defer` matters: the bundle carries React, and a blocking script here
        would sit on the merchant's LCP. It self-initialises on DOMContentLoaded
        and re-initialises on shopify:section:load for the theme editor.

        IFRAME REMAINS THE DEFAULT and the rollback: flip this setting back and
        the block returns to the proven path with no deploy.
      {%- endcomment -%}
      <div
        data-wiskr-quiz
        data-quiz-id="{{ quiz_id }}"
        data-locale="{{ request.locale.iso_code }}"
      ></div>
      <script defer src="{{ clean_url }}/embed/wiskr-embed.js"></script>
    {%- else -%}
    <iframe
      id="qz-frame-{{ block.id }}"
      src="{{ clean_url }}/q/{{ quiz_id }}?locale={{ request.locale.iso_code }}"
      title="{{ block.settings.iframe_title | default: 'Product finder quiz' }}"
      loading="lazy"
      allow="clipboard-write"
      style="display:block;width:100%;border:0;min-height:{{ block.settings.min_height | default: 720 }}px;background:transparent;"
    ></iframe>
    <script>
      // In-Quiz Add-On: the quiz iframe (cross-origin) can't call the AJAX cart
      // itself, so it posts a "qz:add-to-cart" message; we add same-origin via
      // /cart/add.js, ack back so the quiz stays put, and toast. If we don't ack
      // (e.g. add failed), the quiz falls back to a cart permalink.
      (function () {
        var APP = {{ clean_url | json }};
        var QUIZ_ID = {{ quiz_id | json }};
        var BTN_LABEL = {{ block.settings.button_label | default: 'Take the quiz' | json }};
        var appOrigin = null;
        try { appOrigin = new URL(APP).origin; } catch (e) {}
        function toast(msg) {
          var t = document.createElement("div");
          t.textContent = msg;
          t.setAttribute("role", "status");
          t.setAttribute("aria-live", "polite");
          t.className = "quizocalypse-block__toast";
          document.body.appendChild(t);
          setTimeout(function () { t.remove(); }, 2500);
        }
        var frame = document.getElementById("qz-frame-{{ block.id }}");
        var MIN_H = {{ block.settings.min_height | default: 720 }};
        window.addEventListener("message", function (e) {
          if (appOrigin && e.origin !== appOrigin) return;
          var d = e.data;
          if (!d) return;
          // Auto-resize: the quiz reports its content height so the iframe
          // never shows an inner scrollbar or a block of dead whitespace.
          // min_height stays the floor; 4000px is a runaway cap. Only OUR
          // iframe's messages count (a page can host several quiz blocks).
          if (d.type === "qz:height" && frame && e.source === frame.contentWindow) {
            var h = Number(d.height);
            if (isFinite(h) && h > 0) {
              frame.style.height = Math.min(4000, Math.max(MIN_H, Math.ceil(h))) + "px";
            }
            return;
          }
          if (d.type !== "qz:add-to-cart" || !d.variantId) return;
          // Ack on RECEIPT so the quiz cancels its permalink fallback (avoids a
          // double-add if the cart write is slow). Post :fail only if it errors.
          function reply(type) {
            try { e.source && e.source.postMessage({ type: type }, appOrigin || "*"); } catch (_) {}
          }
          reply("qz:add-to-cart:ok");
          fetch("/cart/add.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ items: [{ id: Number(d.variantId), quantity: d.quantity || 1 }] }),
          })
            .then(function (r) { if (!r.ok) throw new Error("add failed"); return r.json(); })
            .then(function () {
              try { document.dispatchEvent(new CustomEvent("cart:refresh")); } catch (_) {}
              toast("Added to cart");
            })
            .catch(function () { reply("qz:add-to-cart:fail"); });
        });

        // Placement propagation — the placement the merchant picked in the
        // builder now drives the storefront: "popup" swaps the inline iframe
        // for a launch button + centered modal (the launcher's proven
        // geometry: 720 max width, 90vh capped at 800); "product_widget"
        // renders the compact variant of the same launcher. Read from the
        // public quiz JSON (CORS-open, 60s-cached, no auth). Anything else —
        // page, inline, absent placement, a failed fetch — keeps the inline
        // iframe exactly as before, so this can never produce a dead block.
        function toLauncher(compact) {
          if (!frame || !frame.parentElement) return;
          var host = frame.parentElement;
          var src = frame.src;
          var frameTitle = frame.title;
          frame.remove();
          var btn = document.createElement("button");
          btn.type = "button";
          btn.className =
            "quizocalypse-block__launch" +
            (compact ? " quizocalypse-block__launch--compact" : "");
          btn.textContent = BTN_LABEL;
          var modal = document.createElement("div");
          modal.className = "quizocalypse-block__modal";
          modal.setAttribute("role", "dialog");
          modal.setAttribute("aria-modal", "true");
          modal.setAttribute("aria-label", frameTitle || BTN_LABEL);
          var mFrame = document.createElement("iframe");
          mFrame.className = "quizocalypse-block__modal-frame";
          mFrame.title = frameTitle || BTN_LABEL;
          mFrame.setAttribute("allow", "clipboard-write");
          var closeBtn = document.createElement("button");
          closeBtn.type = "button";
          closeBtn.className = "quizocalypse-block__modal-close";
          closeBtn.setAttribute("aria-label", "Close");
          closeBtn.textContent = "×";
          modal.appendChild(mFrame);
          modal.appendChild(closeBtn);
          function openModal() {
            if (!mFrame.src) mFrame.src = src; // load the quiz on first open
            modal.classList.add("open");
          }
          function closeModal() { modal.classList.remove("open"); }
          btn.addEventListener("click", openModal);
          closeBtn.addEventListener("click", closeModal);
          modal.addEventListener("click", function (e) { if (e.target === modal) closeModal(); });
          document.addEventListener("keydown", function (e) { if (e.key === "Escape") closeModal(); });
          host.appendChild(btn);
          host.appendChild(modal);
        }
        try {
          fetch(APP + "/q/" + QUIZ_ID + ".json")
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (doc) {
              var p = doc && doc.placement;
              if (p === "popup") toLauncher(false);
              else if (p === "product_widget") toLauncher(true);
            })
            .catch(function () { /* keep the inline iframe */ });
        } catch (e) { /* keep the inline iframe */ }
      })();
    </script>
    {%- endif -%}
  {%- else -%}
    <div class="quizocalypse-block__empty" role="status">
      <strong>Wiskr quiz block</strong><br/>
      Open this block's settings in the theme editor and paste your
      <em>Quiz ID</em> (copy it from the quiz's Embed panel in the Wiskr admin).
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Wiskr Quiz",
  "target": "section",
  "stylesheet": "block.css",
  "settings": [
    {
      "type": "header",
      "content": "Quiz source"
    },
    {
      "type": "text",
      "id": "quiz_id",
      "label": "Quiz ID",
      "info": "Copy it from the quiz's Embed panel in the Wiskr admin."
    },
    {
      "type": "url",
      "id": "app_url",
      "label": "App URL",
      "default": "https://quizocalypse-studio.fly.dev",
      "info": "Prefilled with the Wiskr app URL — only change this if support tells you to (e.g. a dev tunnel)."
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "select",
      "id": "render_mode",
      "label": "Rendering",
      "options": [
        { "value": "iframe", "label": "Iframe (default)" },
        { "value": "dom", "label": "Inline in your theme (beta)" }
      ],
      "default": "iframe",
      "info": "Inline lets the quiz inherit your theme's fonts and add to cart without leaving the page. Switch back to Iframe at any time if anything looks wrong."
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "text",
      "id": "iframe_title",
      "label": "Accessibility title",
      "default": "Product finder quiz",
      "info": "Used as the iframe's title attribute for screen readers."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Launch button label",
      "default": "Take the quiz",
      "info": "Shown when the quiz's placement is Pop-up or Product page widget (set in the Wiskr builder)."
    }
  ]
}
{% endschema %}
