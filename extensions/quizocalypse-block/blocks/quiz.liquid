{% comment %}
  Wiskr Quiz — App Block.
  Renders the merchant's published quiz inline via iframe.
  Configure the Quiz ID in the theme editor (the App URL is prefilled).
{% endcomment %}

{%- assign clean_url = block.settings.app_url | strip | replace: ' ', '' -%}
{%- assign quiz_id = block.settings.quiz_id | strip -%}

<div class="quizocalypse-block" {{ block.shopify_attributes }}>
  {%- if quiz_id != blank and clean_url != blank -%}
    <iframe
      id="qz-frame-{{ block.id }}"
      src="{{ clean_url }}/q/{{ quiz_id }}?locale={{ request.locale.iso_code }}"
      title="{{ block.settings.iframe_title | default: 'Product finder quiz' }}"
      loading="lazy"
      allow="clipboard-write"
      style="display:block;width:100%;border:0;min-height:{{ block.settings.min_height | default: 720 }}px;background:transparent;"
    ></iframe>
    <script>
      // In-Quiz Add-On: the quiz iframe (cross-origin) can't call the AJAX cart
      // itself, so it posts a "qz:add-to-cart" message; we add same-origin via
      // /cart/add.js, ack back so the quiz stays put, and toast. If we don't ack
      // (e.g. add failed), the quiz falls back to a cart permalink.
      (function () {
        var APP = {{ clean_url | json }};
        var appOrigin = null;
        try { appOrigin = new URL(APP).origin; } catch (e) {}
        function toast(msg) {
          var t = document.createElement("div");
          t.textContent = msg;
          t.setAttribute("role", "status");
          t.setAttribute("aria-live", "polite");
          t.className = "quizocalypse-block__toast";
          document.body.appendChild(t);
          setTimeout(function () { t.remove(); }, 2500);
        }
        var frame = document.getElementById("qz-frame-{{ block.id }}");
        var MIN_H = {{ block.settings.min_height | default: 720 }};
        window.addEventListener("message", function (e) {
          if (appOrigin && e.origin !== appOrigin) return;
          var d = e.data;
          if (!d) return;
          // Auto-resize: the quiz reports its content height so the iframe
          // never shows an inner scrollbar or a block of dead whitespace.
          // min_height stays the floor; 4000px is a runaway cap. Only OUR
          // iframe's messages count (a page can host several quiz blocks).
          if (d.type === "qz:height" && frame && e.source === frame.contentWindow) {
            var h = Number(d.height);
            if (isFinite(h) && h > 0) {
              frame.style.height = Math.min(4000, Math.max(MIN_H, Math.ceil(h))) + "px";
            }
            return;
          }
          if (d.type !== "qz:add-to-cart" || !d.variantId) return;
          // Ack on RECEIPT so the quiz cancels its permalink fallback (avoids a
          // double-add if the cart write is slow). Post :fail only if it errors.
          function reply(type) {
            try { e.source && e.source.postMessage({ type: type }, appOrigin || "*"); } catch (_) {}
          }
          reply("qz:add-to-cart:ok");
          fetch("/cart/add.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ items: [{ id: Number(d.variantId), quantity: d.quantity || 1 }] }),
          })
            .then(function (r) { if (!r.ok) throw new Error("add failed"); return r.json(); })
            .then(function () {
              try { document.dispatchEvent(new CustomEvent("cart:refresh")); } catch (_) {}
              toast("Added to cart");
            })
            .catch(function () { reply("qz:add-to-cart:fail"); });
        });
      })();
    </script>
  {%- else -%}
    <div class="quizocalypse-block__empty" role="status">
      <strong>Wiskr quiz block</strong><br/>
      Open this block's settings in the theme editor and paste your
      <em>Quiz ID</em> (copy it from the quiz's Embed panel in the Wiskr admin).
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Wiskr Quiz",
  "target": "section",
  "stylesheet": "block.css",
  "settings": [
    {
      "type": "header",
      "content": "Quiz source"
    },
    {
      "type": "text",
      "id": "quiz_id",
      "label": "Quiz ID",
      "info": "Copy it from the quiz's Embed panel in the Wiskr admin."
    },
    {
      "type": "url",
      "id": "app_url",
      "label": "App URL",
      "default": "https://quizocalypse-studio.fly.dev",
      "info": "Prefilled with the Wiskr app URL — only change this if support tells you to (e.g. a dev tunnel)."
    },
    {
      "type": "header",
      "content": "Display"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 400,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 720
    },
    {
      "type": "text",
      "id": "iframe_title",
      "label": "Accessibility title",
      "default": "Product finder quiz",
      "info": "Used as the iframe's title attribute for screen readers."
    }
  ]
}
{% endschema %}
