{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "quizocalypse/flow-template",
  "title": "Quiz flow template",
  "description": "A reusable, catalog-agnostic quiz skeleton. The generator selects one by category, binds maps_to to real product attributes, expands within the length band, and validates against build-rules.json.",
  "type": "object",
  "required": ["id", "name", "category", "length", "gate", "result_shape", "arc", "branching", "questions", "recommendation", "sources"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "description": "kebab-case unique id" },
    "name": { "type": "string" },
    "category": { "type": "string", "description": "e.g. beauty/custom-formulation, gifting, apparel/fit" },
    "variant": { "type": "string", "description": "optional sub-pattern label" },
    "use_when": { "type": "string", "description": "one line: when the generator should pick this template" },
    "length": {
      "type": "object",
      "required": ["min", "max", "band"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer" },
        "max": { "type": "integer" },
        "band": { "enum": ["short", "medium", "long"] },
        "note": { "type": "string" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["placement", "style", "rationale"],
      "additionalProperties": false,
      "properties": {
        "placement": { "enum": ["at_result", "before_results", "deferred_to_action", "mid_flow", "front"] },
        "style": { "enum": ["soft", "hard"] },
        "rationale": { "type": "string" }
      }
    },
    "result_shape": {
      "enum": ["single_bespoke_output", "ranked_shortlist", "profile_plus_first_box"],
      "description": "the three observed archetypes"
    },
    "arc": {
      "type": "array",
      "items": { "type": "string" },
      "description": "ordered phase labels (easy->goals->config)"
    },
    "branching": { "enum": ["light", "moderate", "heavy"] },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["ordinal", "id", "prompt", "type", "maps_to", "weight_tier"],
        "additionalProperties": false,
        "properties": {
          "ordinal": { "type": "integer" },
          "id": { "type": "string" },
          "prompt": { "type": "string" },
          "type": { "enum": ["single_select", "image_choice", "multi_select", "binary", "scale", "ranking", "short_text", "dropdown"] },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label"],
              "additionalProperties": false,
              "properties": {
                "label": { "type": "string" },
                "maps_to": { "type": "string", "description": "catalog attribute value this answer tags" }
              }
            }
          },
          "maps_to": { "type": "string", "description": "the catalog attribute this question resolves (bind to a real tag/metafield)" },
          "weight_tier": { "enum": ["primary", "secondary", "tie_breaker", "none"], "description": "predictive weight; none = personalization/lead only, not scored" },
          "multi_select_cap": { "type": "integer", "description": "required when type=multi_select" },
          "branch": { "type": "string", "description": "optional: which later questions this answer gates" },
          "note": { "type": "string" }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "required": ["architecture", "tie_break", "empty_fallback", "deterministic", "explainable"],
      "additionalProperties": false,
      "properties": {
        "architecture": { "enum": ["route_tree", "attribute_filter", "weighted_score", "hybrid"] },
        "tie_break": { "type": "string", "description": "the deterministic tie-break chain" },
        "empty_fallback": { "type": "string", "description": "the never-empty ladder" },
        "deterministic": { "const": true },
        "explainable": { "const": true }
      }
    },
    "personalization_hooks": { "type": "array", "items": { "type": "string" } },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
